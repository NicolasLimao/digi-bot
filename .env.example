# Token do bot Discord (obrigatório) — Discord Developer Portal > Bot > Token
DISCORD_BOT_TOKEN=

# URL da Digi RAG API (obrigatório) — endpoint /api/rag/query
# A URL do /api/ingest é derivada automaticamente desta.
# Ex.: https://digi-api.squareweb.app/api/rag/query  (produção)
# Ex.: http://localhost:8000/api/rag/query           (desenvolvimento)
RAG_API_URL=

# IDs dos canais do Discord (opcional — tem default no código)
CANAL_INGESTAO=1491637301522989198
CANAL_CONSULTA=1491637352513142914
